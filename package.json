{
  "name": "pharmacy-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LAN-resilient pharmacy operations platform for Pakistani pharmacies",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build --workspace @pharmacy/config && npm run build --workspace @pharmacy/shared && npm run build --workspace @pharmacy/database",
    "build:apps": "npm run build --workspace @pharmacy/api && npm run build --workspace @pharmacy/worker && npm run build --workspace @pharmacy/web",
    "dev": "npm run build:packages && node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test --workspaces --if-present",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace @pharmacy/database",
    "db:seed": "npm run seed --workspace @pharmacy/database",
    "db:seed:development": "npm run seed:development --workspace @pharmacy/api",
    "prepare": "husky",
    "secrets:rotate-local": "node scripts/rotate-local-secrets.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "*.{js,mjs,cjs,jsx,ts,tsx}": "eslint --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.3",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
