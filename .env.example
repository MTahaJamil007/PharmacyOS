NODE_ENV=development
HOST=0.0.0.0
API_PORT=3001
HTTP_PORT=80
HTTPS_PORT=443
PHARMACY_HOSTNAME=pharmacy.lan
WEB_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace-with-a-strong-postgres-admin-password
POSTGRES_APP_PASSWORD=replace-with-a-different-strong-application-password
DATABASE_URL=postgres://pharmacy_app:change-me@localhost:5432/pharmacy_os
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/pharmacy_os
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-12-character-development-password
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_MINUTES=720
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5
ACCOUNT_LOCKOUT_FAILURES=5
ACCOUNT_LOCKOUT_MINUTES=15
RESERVATION_TTL_MINUTES=8
WORKER_ID=worker-local-1
WORKER_HEALTH_FILE=
FBR_MODE=DISABLED
AI_ENABLED=false
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=
AI_MAX_TOOL_CALLS=4
AI_REQUEST_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_MINUTE=10
VITE_API_URL=http://localhost:3001/api/v1
ALLOW_DEVELOPMENT_SEED=false
DEVELOPMENT_SEED_PASSWORD=replace-with-a-development-only-password
DEVELOPMENT_MEDICINE_COUNT=500

# Docker Compose substitutes ${...} from the shell or the file passed with --env-file;
# the service-level env_file setting does not participate in Compose interpolation.
# Generate the age identity before deployment and keep it off the database disk.
BACKUP_EXTERNAL_PATH=/media/pharmacy-backup
BACKUP_AGE_IDENTITY_FILE=./secrets/backup-age-identity.txt
BACKUP_AGE_RECIPIENT=replace-with-the-age1-public-recipient
BACKUP_SCHEDULE_HOUR=1
BACKUP_TIMEZONE=Asia/Karachi
BACKUP_RUN_ON_START=true
RESTORE_DRILL_DAY=0
